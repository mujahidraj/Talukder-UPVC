# ─── Database ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/talukder-upvc

# ─── Auth (JWT) ───────────────────────────────────────────
# Generate secure random strings for production
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── File Storage ─────────────────────────────────────────
UPLOAD_DRIVER=local
UPLOAD_LOCAL_PATH=./uploads

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=noreply@talukder-upvc.com
SALES_TEAM_NOTIFICATION_EMAIL=sales@talukder-upvc.com

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=500

# ─── Admin Seed ───────────────────────────────────────────
# Initial Super Admin credentials (change after first login)
SUPER_ADMIN_EMAIL=admin@talukder-upvc.com
SUPER_ADMIN_PASSWORD=change-me-on-first-login

# ─── App ──────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
